    <!-- Stimmpakete -->
    <string name="pack_note_kokoro_en">Official Kokoro package from sherpa-onnx. Includes espeak-ng-data, which the German voices use as well.</string>
    <string name="pack_note_kokoro_multi">Kokoro 1.0 with 28 English voices (American and British), compressed to int8. Very natural sounding. The voices can be mixed.</string>
    <string name="pack_note_supertonic">One model for German, English and 29 more languages with 10 speakers each, 24 kHz. Natural sounding; needs more computing time than Piper. Licence OpenRAIL-M.</string>
    <string name="pack_note_thorsten_small">German voice by Thorsten Müller (CC0 data), compressed to int8. Small and fast, brings espeak-ng-data along. Good starting point for German.</string>
    <string name="pack_note_thorsten_high">The “high” quality of Thorsten, compressed to int8. Sounds clearer than “medium” and needs a bit more computing time.</string>
    <string name="pack_note_thorsten_full">Thorsten “high” uncompressed. Same voice as the int8 version, three times the size.</string>
    <string name="pack_note_thorsten_emotional">Thorsten with eight moods (amused, angry, disgusted, drunk, neutral, sleepy, surprised, whisper). Suits direct speech.</string>
    <string name="pack_note_piper_female">German female voice from the Piper project, compressed to int8.</string>
    <string name="pack_note_piper_female_small">German female voice from the Piper project in the smallest quality level. Very fast, sounds less clear.</string>
    <string name="pack_note_piper_male">German male voice from the Piper project, compressed to int8.</string>
    <string name="pack_note_piper_en">US English voice from the Piper project, compressed to int8. Small and fast.</string>
    <string name="pack_note_piper_en_gb">British English voice from the Piper project, compressed to int8.</string>
    <string name="pack_note_kitten">Very small English model with 8 voices. Fast on older devices.</string>
    <string name="pack_note_kokoro_multi_full">Kokoro 1.0 uncompressed. Same voices as the int8 version, more than twice the size.</string>
    <string name="pack_note_martin">Single male voice (Martin Harbecke), Apache 2.0. Prepared for sherpa-onnx automatically after the download. Needs espeak-ng-data from another package (Kokoro English or Thorsten).</string>
    <string name="pack_note_kokoro_thorsten">Thorsten-Voice/Kokoro is only available as PyTorch (.pth). Export it to ONNX (see README) and place model.onnx and voices-thorsten.npz in the folder. The app prepares the rest.</string>
